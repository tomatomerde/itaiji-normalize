{
  "name": "itaiji-normalize",
  "version": "0.1.0",
  "description": "Grounded itaiji (kanji variant) normalization, equivalence, and matching-key generation using IPA's MJ Shrink Map",
  "keywords": [
    "itaiji",
    "kanji",
    "variant",
    "japanese",
    "normalization",
    "mj-shrink-map",
    "ivs",
    "unicode"
  ],
  "author": "tomatomerde (https://github.com/tomatomerde)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "LICENSE",
    "LICENSE-DATA",
    "data/snapshot/PROVENANCE.md"
  ],
  "homepage": "https://github.com/tomatomerde/itaiji-normalize#readme",
  "bugs": {
    "url": "https://github.com/tomatomerde/itaiji-normalize/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build:tables": "tsx scripts/build-tables.ts",
    "build": "tsup",
    "test": "vitest run",
    "test:browser": "node scripts/verify-browser.mjs",
    "test:workers": "node scripts/verify-workers.mjs",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "playwright": "^1.62.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10",
    "workerd": "^1.20260804.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomatomerde/itaiji-normalize.git"
  }
}
